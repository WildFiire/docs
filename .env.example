# ============================================================
# WildFire Docs & API — Environment Configuration Template
# ============================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the values appropriate for your environment.
# 3. NEVER commit .env or any secret keys to version control.
# ============================================================

# ── Server & Process Settings ─────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000

# ── Public Platform URLs ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin Security & Authentication ───────────────────────────
# Minimum 32-character random string for HMAC session token signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=dev_fortress_key_change_me_to_random_32_characters_min

# Initial temporary password for first-time account initialization
ADMIN_INITIAL_PASSWORD=dev_initial_setup_pass

# Default password hashing salt (leave unset to generate dynamically)
# ADMIN_DEFAULT_SALT=

# Secret required for internal background polling of GitOps changes
INTERNAL_POLL_SECRET=dev_internal_poll_secret_change_me

# ── GitHub Integration & Multi-Repo GitOps ───────────────────
GITHUB_REPO_OWNER=Wildfiire
GITHUB_REPO_NAME=docs
GITHUB_DOCS_BRANCH=main
GITHUB_TOKEN=
GITHUB_SYNC_TOKEN=
GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_TOKEN=

# ── AI Analytics (Google Gemini) ──────────────────────────────
# Obtain your free API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# ── Supabase PostgreSQL Database (Main Docs DB) ───────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key

# ── Discord Bot Control Center ────────────────────────────────
BOT_SUPABASE_URL=https://your-bot-project-id.supabase.co
BOT_SUPABASE_KEY=your_bot_supabase_service_role_private_key
DISCORD_BOT_TOKEN=
DISCORD_BOT_AVATAR_URL=https://docs.wildfire.ro/icons/wildfire.webp

# ── Discord Webhooks (Notifications & Telemetry) ─────────────
DISCORD_WEBHOOK_URL=
DISCORD_LOGS_WEBHOOK_URL=
DISCORD_PROCEDURA_WEBHOOK_URL=
DISCORD_AUTH_WEBHOOK_URL=
DISCORD_SECURITY_WEBHOOK_URL=
DISCORD_TEAM_WEBHOOK_URL=
DISCORD_AI_WEBHOOK_URL=
DISCORD_CONTENT_WEBHOOK_URL=
DISCORD_MEDIA_WEBHOOK_URL=
DISCORD_REPORTS_WEBHOOK_URL=
DISCORD_SYSTEM_WEBHOOK_URL=
DISCORD_SNAPSHOTS_WEBHOOK_URL=
DISCORD_GITOPS_WEBHOOK_URL=
DISCORD_SETTINGS_WEBHOOK_URL=
DISCORD_TASKS_WEBHOOK_URL=

# ── Email Service (Optional / Resend) ─────────────────────────
EMAIL_FROM=WildFire Docs <docs@wildfire.ro>
RESEND_API_KEY=
